[Unit]
Description=Polymarket book recorder - eth 5m - top of book at fixed leads before close
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
# measurement only: never trades, never touches a bot ledger. Lowest CPU
# share on the box so it can never starve a money bot at a window boundary.
CPUWeight=50
WorkingDirectory=/opt/polymarketstrat
Environment=COIN=eth
Environment=FAMILY=5m
# accuracy at >5bp holds far earlier than the original 120s ceiling
# (btc 15m: 98.6% at 180s, 95.5% at 300s) and those prices have
# never been observed. Cannot be back-filled, so record them now.
Environment=PREOPEN=20,10,5,3
Environment=LEADS=298,285,270,240,180,150,120,90,60,45,30,20,10,6,3
Environment=BOOK_DIR=/opt/polymarketstrat/bot/data/bookcal
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.book_record
Restart=always
RestartSec=10
MemoryMax=120M

[Install]
WantedBy=multi-user.target
