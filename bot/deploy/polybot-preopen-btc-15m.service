[Unit]
Description=Polymarket PRE-OPEN paper bot (btc 15m) - buy the tilt side before the window opens
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=COIN=btc
# FAMILY=15m also derives ORACLE_TWAP_S=60 in bot/config.py — the strike here
# is a SIXTY second trailing mean, so the same mechanism produces a larger
# tilt than the 5m family and 15% of windows clear 1bp against the 5m's 8%.
Environment=FAMILY=15m
Environment=WINDOW_SECS=900
Environment=SLUG_PREFIX=btc-updown-15m
Environment=SPOT_FEED=coinbase
Environment=PREOPEN_ENABLED=1
Environment=SNIPE_ENABLED=0
Environment=TOLL_ENABLED=0
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/preopen-btc15
Environment=PREOPEN_LEAD_S=3
# 1.0bp, NOT the 0.5 the 5m unit runs. On the 5m tape the 0.5-1bp bucket
# settles 62% against a 53.6% break-even but its 95% floor is 51.0% — it does
# not clear — while 1-2bp settles 72% with a 57.2% floor and does. There is no
# 15m evidence below 1bp at all, and no reason to gather it by TRADING it:
# bot/scalp_backtest.py measures every window in the grid whether the bot
# touched it or not, so the gate should sit where the evidence is.
Environment=PREOPEN_TILT_MIN_BP=1.0
Environment=PREOPEN_MAX_PX=0.56
Environment=PREOPEN_CLIP=250
Environment=LOG_LEVEL=INFO
Environment=MAX_DAILY_LOSS=250
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=10
MemoryMax=200M

[Install]
WantedBy=multi-user.target
