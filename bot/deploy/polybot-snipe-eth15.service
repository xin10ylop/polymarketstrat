[Unit]
Description=Polymarket paper bot - SNIPE only (eth 15m family, strict-signal experiment)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=SPOT_FEED=coinbase
Environment=COIN=eth
Environment=FAMILY=15m
Environment=WINDOW_SECS=900
Environment=SLUG_PREFIX=eth-updown-15m
Environment=TOLL_ENABLED=0
# Runs DEFAULT signal settings (audit round 3 demolished the fv=0.999 tape
# claim: 4 lucky large fills carried it, CI spans zero, and the runbook's own
# law says never tune eth off the replica). Neutral true-feed evidence only.
Environment=BOOK_MAX_AGE_S=15
Environment=SNIPE_WARMUP_S=1800
Environment=SNIPE_MAX_CLIP=500
Environment=SNIPE_WINDOW_MAX_COST=500
Environment=MAX_DAILY_LOSS=650
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/snipe-eth15
Environment=LOG_LEVEL=INFO
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
