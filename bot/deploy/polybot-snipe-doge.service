[Unit]
Description=Polymarket paper bot - SNIPE only (doge, top-band experiment)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=SPOT_FEED=coinbase
Environment=COIN=doge
Environment=TOLL_ENABLED=0
# 41-day replica: only the 0.90-0.97 band is +EV on doge (deep/mid bands
# measured -5 to -7c/sh); this floor IS the strategy here, do not remove it
Environment=SNIPE_PRICE_FLOOR=0.90
Environment=MAX_DAILY_LOSS=250
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/snipe-doge
Environment=LOG_LEVEL=INFO
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=150M

[Install]
WantedBy=multi-user.target
