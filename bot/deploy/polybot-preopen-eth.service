[Unit]
Description=Polymarket PRE-OPEN paper bot (eth 5m) - buy the tilt side before the window opens
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=COIN=eth
Environment=FAMILY=5m
Environment=WINDOW_SECS=300
Environment=SLUG_PREFIX=eth-updown-5m
Environment=SPOT_FEED=coinbase
# ONLY the pre-open strategy trades in this unit. Its own data dir keeps the
# ledger separate from the snipe's, so neither strategy's risk breakers or
# PnL can be confused with the other's.
Environment=PREOPEN_ENABLED=1
Environment=SNIPE_ENABLED=0
Environment=TOLL_ENABLED=0
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/preopen-eth
# 3s: sign accuracy is 98.9% there and 83% at 10s. Measured, not chosen.
Environment=PREOPEN_LEAD_S=3
# 0.5 since 2026-08-19, under the RULE2 (60s-strike) tilt definition. The
# old 1.0 was measured on the 30s strike ("eth's 0.25-1.0bp buckets sit at
# 52-54%") and is obsolete — RULE2 changed what a basis point of tilt IS.
# On 5.5 days of new-rule tape (gate_sweep SINCE=1786665600): 0.5 beats
# 1.0 on c/day in BOTH halves (+767.3/+311.3, +368.8/+146.8) and the
# 0.5-1.0bp band earns +5.10c at its own recorded T-3 ask — the two-table
# condition pre-registered on 08-13. REVERT if a ~3-day re-run shows 0.5
# no longer ahead in both halves.
Environment=PREOPEN_TILT_MIN_BP=0.5
# a flat pre-open book sits near 0.50 both sides; above this the makers have
# already priced the tilt and the entry is no longer the one we measured
Environment=PREOPEN_MAX_PX=0.56
Environment=PREOPEN_CLIP=250
Environment=LOG_LEVEL=INFO
Environment=MAX_DAILY_LOSS=250
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=10
MemoryMax=200M

[Install]
WantedBy=multi-user.target
