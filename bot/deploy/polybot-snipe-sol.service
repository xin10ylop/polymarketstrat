[Unit]
Description=Polymarket paper bot - SNIPE only (sol)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=SPOT_FEED=coinbase
Environment=COIN=sol
Environment=TOLL_ENABLED=0
# sparse tape + no settled-fill record of its own: tighter bar-age cap than
# the fleet default until SOL earns one (Fable bar-age audit, 07-31)
Environment=SPOT_MAX_BAR_AGE_S=3.0
Environment=MAX_DAILY_LOSS=250
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/snipe-sol
Environment=LOG_LEVEL=INFO
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
