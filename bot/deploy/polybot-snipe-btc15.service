[Unit]
Description=Polymarket paper bot - SNIPE only (btc 15m family)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=SPOT_FEED=coinbase
Environment=COIN=btc
Environment=FAMILY=15m
Environment=WINDOW_SECS=900
Environment=SLUG_PREFIX=btc-updown-15m
Environment=TOLL_ENABLED=0
# 900s windows: give the vol estimator a full 2x window before trusting it
Environment=BOOK_MAX_AGE_S=15
# Kalshi telemetry overlay: log Kalshi's concurrent price on every take
# attempt (depth events, "k" field). TELEMETRY ONLY — trading unchanged,
# PnL series stays comparable. Runbook 2026-08-02 addendum.
Environment=KALSHI_TELEMETRY=1
Environment=SNIPE_WARMUP_S=1800
Environment=SNIPE_MAX_CLIP=500
Environment=SNIPE_WINDOW_MAX_COST=500
Environment=MAX_DAILY_LOSS=650
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/snipe-btc15
Environment=LOG_LEVEL=INFO
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
