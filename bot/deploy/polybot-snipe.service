[Unit]
Description=Polymarket paper bot - SNIPE only
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20
# no Conflicts= line: another project on this host owns the name polybot.service;
# a conflict declaration here lets that project's deploys silently stop this bot

[Service]
NoNewPrivileges=true
Type=simple
# window boundaries wake every bot at once on a shared vCPU;
# money bots must win that contention (ws-staleness audit 2026-08-06)
CPUWeight=400
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=COIN=btc
Environment=FAMILY=5m
Environment=WINDOW_SECS=300
Environment=SLUG_PREFIX=btc-updown-5m
Environment=SPOT_FEED=coinbase
Environment=TOLL_ENABLED=0
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/snipe
Environment=LOG_LEVEL=INFO
# snipe takes up to 250-share clips (~$200); one normal losing trade exceeds the
# default $25 breaker, which would end every losing day at its first loss and
# starve the qualification sample. $250 = ~2 losing trades, still a hard stop.
Environment=MAX_DAILY_LOSS=250
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
