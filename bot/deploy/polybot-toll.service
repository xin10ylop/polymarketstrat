[Unit]
Description=Polymarket paper bot - TOLL only
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=SPOT_FEED=coinbase
Environment=SNIPE_ENABLED=0
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/toll
Environment=LOG_LEVEL=INFO
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
