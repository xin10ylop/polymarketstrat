[Unit]
Description=Polymarket paper bot - SNIPE only (btc 1h hourly family)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
# window boundaries wake every bot at once on a shared vCPU;
# money bots must win that contention (ws-staleness audit 2026-08-06)
CPUWeight=100
WorkingDirectory=/opt/polymarketstrat
Environment=BOT_MODE=paper
Environment=SPOT_FEED=coinbase
Environment=COIN=btc
Environment=FAMILY=1h
Environment=WINDOW_SECS=3600
Environment=SLUG_PREFIX=bitcoin-up-or-down
Environment=SLUG_STYLE=et_hourly
Environment=ORACLE_AUTHORITATIVE=0
Environment=TOLL_ENABLED=0
Environment=BOOK_MAX_AGE_S=45
# hourly outcomes publish via UMA proposal ~11-13 min after the hour; the
# default 600s reconciler patience gave up 2 min before every publish
Environment=OUTCOME_PATIENCE_S=1800
Environment=SNIPE_WARMUP_S=1800
Environment=SNIPE_MAX_CLIP=500
Environment=SNIPE_WINDOW_MAX_COST=500
Environment=MAX_DAILY_LOSS=650
Environment=BOT_DATA_DIR=/opt/polymarketstrat/bot/data/snipe-btc1h
Environment=LOG_LEVEL=INFO
ExecStart=/opt/polymarketstrat/venv/bin/python -m bot.main
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
