# Live trading environment — copy to /etc/polybot/live.env on the LIVE server:
#   mkdir -p /etc/polybot && cp live.env.template /etc/polybot/live.env
#   chmod 600 /etc/polybot/live.env
# FILL THE SECRETS DIRECTLY ON THE SERVER. Never paste them in chat/email/git.

BOT_MODE=live
COIN=btc
TOLL_ENABLED=0
SNIPE_ENABLED=1

# --- money (Tier 0 = $150; move per the ladder in the runbook) ---
BANKROLL=150
LIVE_PER_TRADE_FRAC=0.10
LIVE_DAILY_STOP_FRAC=0.20
LIVE_MAX_TRADES_DAY=40
LIVE_STRATEGIES=snipe

# --- safety locks (both must be flipped deliberately, in this order) ---
# 1) leave LIVE_SHADOW=1 for the first 24-48h: full pipeline INCLUDING order
#    signing (validates credentials/allowances/tick sizes), no real orders.
#    LIVE_CONFIRM is NOT needed for shadow — it is the lock on real POSTs.
# 2) then set LIVE_SHADOW=0 AND type the confirm phrase to go real:
#    LIVE_CONFIRM=I-UNDERSTAND-REAL-MONEY
LIVE_SHADOW=1
LIVE_CONFIRM=

# --- Polymarket credentials (from your account; bot derives API keys itself) ---
# email/Magic-wallet account: export private key in Polymarket settings,
#   funder = your Polymarket profile (proxy) address, signature type 1
# browser-wallet account: wallet's private key, proxy address, signature type 2
PM_PRIVATE_KEY=
PM_FUNDER=
PM_SIGNATURE_TYPE=1

# --- feeds (EU server: binance allowed and slightly richer; coinbase also fine) ---
SPOT_FEED=binance
BOT_DATA_DIR=/opt/polymarketstrat/bot/data/live-btc
LOG_LEVEL=INFO
